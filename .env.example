# Copy to .env and fill in with your own Firebase project + OAuth clients.
# Every value here is CLIENT-SIDE config (safe to ship in the app bundle —
# access control is enforced by Firestore/Storage security rules, not by
# hiding these strings). Real secrets (service account keys, admin SDK
# credentials) never belong in this file or in the app at all.
# See docs/environment.md for where to get each value.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In (expo-auth-session). Create OAuth client IDs per platform
# in Google Cloud Console > APIs & Services > Credentials.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Used only at build/prebuild time by app.config.ts (Android needs an
# explicit Maps SDK key; iOS/expo-maps uses Apple Maps natively, no key).
GOOGLE_MAPS_ANDROID_API_KEY=

# Error monitoring (optional). Public DSN from Sentry > Project Settings > Client Keys.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SUPPORT_EMAIL=
