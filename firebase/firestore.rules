rules_version = '2';

// EcoBike — one Firestore (ecobike-9dedd) shared by web, iOS and Android.
//
// Anything with value (points, redemption codes, ride records, friendships,
// roles) is written ONLY by the server functions in /api (Firebase Admin
// SDK, which bypasses these rules). Clients can read their own data and edit
// harmless profile fields; everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }

    // Fields only the server may change on usuarios/{uid}.
    function serverOnlyUserFields() {
      return ['puntosAcumulados', 'role', 'isAdmin', 'amigos', 'solicitudesPendientes', 'cuentaActiva', 'username', 'storeId'];
    }

    function changes() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Bounded, typed self-edited profile fields (edit-profile screen).
    function validProfileFields() {
      let d = request.resource.data;
      return d.get('bio', '') is string && d.get('bio', '').size() <= 200
        && d.get('nombre', '') is string && d.get('nombre', '').size() <= 60
        && d.get('apellido', '') is string && d.get('apellido', '').size() <= 60
        && d.get('city', '') is string && d.get('city', '').size() <= 80;
    }

    // Profile photos other users see: our Storage bucket or the Google
    // account photo only — never an arbitrary (tracking/abusive) URL.
    function validPhoto(d) {
      return d.get('profileImageUrl', null) == null
        || (d.profileImageUrl is string && d.profileImageUrl.size() <= 2000
            && d.profileImageUrl.matches('^https://(firebasestorage[.]googleapis[.]com|lh[0-9][.]googleusercontent[.]com)/.*'));
    }

    function validPublicNames(d) {
      return d.get('nombre', '') is string && d.get('nombre', '').size() <= 60
        && d.get('apellido', '') is string && d.get('apellido', '').size() <= 60;
    }

    function publicFields() {
      return ['username', 'nombre', 'apellido', 'profileImageUrl', 'puntosAcumulados', 'amigos', 'buscable', 'weekKey', 'weekPoints'];
    }

    // ─── /usuarios/{uid} — private profile (email, fechaNacimiento, ...) ───
    match /usuarios/{uid} {
      allow read: if isOwner(uid);

      // Sign-up (auth.service.ts createUserProfileDoc) starts from zero.
      allow create: if isOwner(uid)
        && request.resource.data.get('puntosAcumulados', 0) == 0
        && request.resource.data.get('role', 'user') == 'user'
        && request.resource.data.get('isAdmin', false) == false
        && request.resource.data.get('amigos', []).size() == 0
        && request.resource.data.get('solicitudesPendientes', []).size() == 0
        && !('storeId' in request.resource.data);

      allow update: if isOwner(uid) && !changes().hasAny(serverOnlyUserFields()) && validProfileFields();
      allow delete: if false; // api/account.js

      // Redemption codes — created by api/redeem.js.
      match /codigos_canjeados/{codeId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Ride summaries — created by api/rides.js together with the points.
      match /rides/{rideId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // ─── /usuarios_public/{uid} — minimal public mirror for search/leaderboard ───
    // Owner may keep name/photo in sync; points, friends and username (unique) come from the server.
    match /usuarios_public/{uid} {
      // By id only: no list queries, so nobody can download every profile.
      // Username search goes through api/friends.js (honors buscable).
      allow get: if isAuth();
      allow list: if false;
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(publicFields())
        && !('username' in request.resource.data) // reserved + written by api/me.js only
        && validPhoto(request.resource.data) && validPublicNames(request.resource.data)
        && request.resource.data.get('puntosAcumulados', 0) == 0
        && request.resource.data.get('weekPoints', 0) == 0
        && request.resource.data.get('amigos', []).size() == 0;
      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(publicFields())
        && request.resource.data.get('buscable', true) is bool
        && (!changes().hasAny(['profileImageUrl']) || validPhoto(request.resource.data))
        && (!changes().hasAny(['nombre', 'apellido']) || validPublicNames(request.resource.data))
        && !changes().hasAny(['puntosAcumulados', 'amigos', 'username', 'weekKey', 'weekPoints']);
      allow delete: if false;
    }

    // ─── /tiendas/{storeId} — rewards catalog. Admin edits via api/stores.js ───
    // Not sensitive; inactive stores (isActive == false) are filtered client-side
    // because rules can't filter an unconstrained list query.
    match /tiendas/{storeId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ─── /chats/{chatId} — 1:1 chats between friends. Written by api/messages.js ───
    // Readable only by its two participants (also enforced on list queries:
    // the app queries with participants array-contains its own uid).
    match /chats/{chatId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      allow write: if false;

      match /messages/{messageId} {
        allow read: if isAuth() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow write: if false;
      }
    }

    // Everything else (including legacy canjes/, challenges/) is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
